# WordPress
DISABLE_WP_CRON=true
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change-me
DB_HOST=mysql
DB_CHARSET=latin1
DB_COLLATE=''
TABLE_PREFIX=wp_
FS_METHOD=direct
WP_DEBUG=false
WP_DEBUG_DISPLAY=false
EMPTY_TRASH_DAYS=7
WP_POST_REVISIONS=10

# Optional persistent object cache. Requires a compatible wp-content/object-cache.php drop-in.
# WP_CACHE=true
# WP_REDIS_HOST=redis.example.internal
# WP_REDIS_PORT=6379
# WP_REDIS_DATABASE=0
# WP_REDIS_TIMEOUT=1
# WP_REDIS_READ_TIMEOUT=1
# WP_REDIS_PREFIX=wordpress
# WP_REDIS_PASSWORD=change-me

# MariaDB
MARIADB_ROOT_PASSWORD=change-me
MARIADB_DATABASE=wordpress
MARIADB_USER=wordpress
MARIADB_PASSWORD=change-me

# Traefik
DOMAIN=example.com
LETSENCRYPT_EMAIL=admin@example.com
# Use staging while testing. Switch to the production directory before go-live.
LETSENCRYPT_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
